# App
APP_URL=http://localhost:3001
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3001

# Shared secret for the Python agent → Next.js internal APIs
AGENT_INTERNAL_SECRET=replace-with-a-long-random-string

# Postgres
DATABASE_URL=postgresql://kimma:kimma@localhost:5433/kimma

# Redis (ephemeral conversation state + rate limits)
REDIS_URL=redis://localhost:6379

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Public URL the browser uses to connect (same as LIVEKIT_URL in local --dev)
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# OpenAI (server and agent only — never expose to the browser)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_ANALYSIS_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# S3-compatible object storage for recordings
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kimma-recordings
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Avatar (deferred; interface only in MVP)
AVATAR_PROVIDER=
AVATAR_API_KEY=

# Optional: LiveKit Cloud agent dispatch name
LIVEKIT_AGENT_NAME=kimma-conversation-agent

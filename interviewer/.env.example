# ---- App ----
# Public URL of the web app (used for Recall bot page and share links)
PUBLIC_BASE_URL=http://localhost:3000
# Shared secret the agent uses to call /api/internal/* (generate: openssl rand -hex 32)
AGENT_INTERNAL_SECRET=

# ---- LiveKit (voice transport) ----
# Local: ws://localhost:7880 with devkey/secret (docker compose up). Cloud: livekit.io project settings.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Agent name used for explicit dispatch
LIVEKIT_AGENT_NAME=aperture-interviewer

# ---- Claude (role profile, candidate research, plan, scoring) ----
ANTHROPIC_API_KEY=
# Model for prep (role profile, research, plan)
PREP_MODEL=claude-sonnet-5-5
# Model for post-call scoring
SCORER_MODEL=claude-opus-5-5

# ---- Voice agent ----
# cascade (STT + LLM + TTS) or openai_realtime
VOICE_MODE=cascade
# Interviewer LLM: openai:<model> or anthropic:<model>
INTERVIEWER_LLM=openai:gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# Speech-to-text
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Text-to-speech: cartesia | elevenlabs | openai
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=

# ---- Agent browser (cloud browser shown on the Agent Screen) ----
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ---- Candidate research ----
EXA_API_KEY=
# Optional, raises GitHub API rate limit
GITHUB_TOKEN=

# ---- Google Meet bot (Recall.ai) ----
RECALL_API_KEY=
RECALL_REGION=us-west-2

# ---- Demo ----
# 1 = short phase timings (1/3/3/4/1 minutes)
DEMO_SHORT_INTERVIEW=0
